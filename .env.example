# Copie para .env e ajuste os valores: cp .env.example .env

# --- Django ---
# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Idioma e fuso ---
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo

# --- Banco de dados ---
# Dev (SQLite):
# Vazio = SQLite em db.sqlite3 na raiz do repositório
# DATABASE_URL=sqlite:///db.sqlite3
# Prod (PostgreSQL) - no docker-compose.prod.yml a URL é montada a partir das variáveis POSTGRES_*
# DATABASE_URL=postgres://consignado:change-me@db:5432/consignado
POSTGRES_DB=consignado
POSTGRES_USER=consignado
POSTGRES_PASSWORD=change-me

# --- CSRF / CORS ---
# Separe múltiplas origens por vírgula (com esquema, ex.: https://app.exemplo.com)
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# --- E-mail (SMTP) ---
# Se EMAIL_HOST ficar vazio, os e-mails são impressos no console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
